{
  "extends": "./tsconfig",
  "compilerOptions": {
    // tsconfig.json compiles src/ into dist/. This one only ever reads, so it
    // needs a rootDir that spans test/ as well and no output at all.
    "rootDir": ".",
    "noEmit": true
  },
  // benchmarks/ and prof.ts call the real API, so they rot the same way a test
  // does when a signature changes — silently, since nothing else reads them.
  // gff.bench.ts is the exception: it imports the two builds
  // scripts/build-both-branches.sh produces, which do not exist until you run
  // `pnpm bench`.
  "include": ["src", "test", "benchmarks", "prof.ts"],
  "exclude": ["benchmarks/gff.bench.ts"]
}
