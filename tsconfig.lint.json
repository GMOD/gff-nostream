{
  "extends": "./tsconfig",
  "compilerOptions": {
    // tsconfig.json compiles src/ into dist/. This one only ever reads, so it
    // needs a rootDir that spans test/ as well and no output at all.
    "rootDir": ".",
    "noEmit": true
  },
  // prof.ts calls the real API, so it rots the same way a test does when a
  // signature changes — silently, since nothing else reads it.
  "include": ["src", "test", "prof.ts"]
}
